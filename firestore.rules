rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to verify user is authenticated
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profile document: strictly locked to the owner
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // User saved bot projects, tokens, and configurations: strictly locked to the owner
    match /users/{userId}/bots/{botId} {
      allow read, write: if isOwner(userId);
    }
    
    // Block all other unknown collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
